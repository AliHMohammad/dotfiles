{
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "files.autoSave": "afterDelay",
    "editor.formatOnType": true,
    "liveServer.settings.donotShowInfoMsg": true,
    "git.autofetch": true,
    "prettier.embeddedLanguageFormatting": "off",
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "hediet.vscode-drawio.resizeImages": null,
    "code-runner.clearPreviousOutput": true,
    "prettier.printWidth": 160,
    "prettier.tabWidth": 4,
    "gitlens.defaultDateFormat": null,
    "git.confirmSync": false,
    "editor.guides.bracketPairs": "active",
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "terminal.integrated.defaultProfile.windows": "zsh",
    "editor.codeActionsOnSave": {},
    "typescript.updateImportsOnFileMove.enabled": "always",
    "html.format.wrapLineLength": 140,
    "workbench.iconTheme": "vscode-icons",
    "editor.lineHeight": 1.45,
    "vsicons.dontShowNewVersionMessage": true,
    "liveServer.settings.CustomBrowser": "firefox",
    "gitlens.graph.minimap.additionalTypes": ["remoteBranches"],
    "gitlens.graph.minimap.enabled": false,
    "workbench.colorTheme": "Atom One Dark",
    "editor.mouseWheelZoom": true,
    "markdown.preview.fontSize": 16,
    "terminal.integrated.scrollback": 3000,
    "prisma.showPrismaDataPlatformNotification": false,
    "files.insertFinalNewline": true,
    "terminal.integrated.shellIntegration.enabled": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "security.workspace.trust.untrustedFiles": "open",
    "cmake.showOptionsMovedNotification": false,
    "editor.fontSize": 16,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "javascript.updateImportsOnFileMove.enabled": "always",
    "database-client.autoSync": true,
    "[go]": {
        "editor.defaultFormatter": "golang.go"
    },
    "aws.lambda.recentlyUploaded": {
        "profile:default": {
            "eu-north-1": "hero-admin"
        },
        "profile:my-dev-profile": {
            "eu-north-1": "hero-persons"
        }
    },
    "aws.resources.enabledResources": ["AWS::RDS::DBInstance"],
    "terminal.integrated.allowChords": false,
    "window.newWindowProfile": "Default",
    "editor.fontFamily": "Consolas, 'Courier New', monospace",
    "editor.fontLigatures": false,
    "docker.extension.enableComposeLanguageServer": false,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "github-actions-workflow": false
    },
    "github.copilot.nextEditSuggestions.enabled": true,
    "docker.extension.dockerEngineAvailabilityPrompt": false,
    "remote.autoForwardPortsSource": "hybrid",
    "aws.telemetry": false,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    }
}
